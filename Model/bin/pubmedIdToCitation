#! /usr/bin/perl

use lib "$ENV{GUS_HOME}/lib/perl";

use LWP::Simple;
use JSON::PP;

use Encode;

use strict;

&usage unless scalar(@ARGV) == 1;
my $pubmedId = $ARGV[0];

my $pmcApiUrl = "https://pmc.ncbi.nlm.nih.gov/api/ctxp/v1/pubmed/?format=citation&id=" . $pubmedId;

my $content = LWP::Simple::get($pmcApiUrl);

die "PMC API did not return a valid response for pubmed id \"$pubmedId\". Request URL was \"$pmcApiUrl\""
  unless $content;

my $json;
eval {
    $json = JSON::PP->new->decode($content);
};
if ($@) {
    die "Failed to parse JSON response for pubmed id \"$pubmedId\": $@";
}

# Check if response is an empty array (PubMed ID not found)
if (ref($json) eq 'ARRAY' && scalar(@$json) == 0) {
    die "PubMed ID \"$pubmedId\" not found. Request URL was \"$pmcApiUrl\"";
}

# Check if mla.orig field exists
die "Response does not contain MLA citation for pubmed id \"$pubmedId\""
  unless exists $json->{mla} && exists $json->{mla}->{orig};

my $citation = $json->{mla}->{orig};

print "$citation\n";

sub usage {
    print STDERR "
usage: pubmedIdToCitation pubmed_id

returns citation
";

    exit(1);
}

